# WARNING:
# Never commit real API keys or secrets to GitHub.
# Keep exchange API keys read-only until paper mode and supervised controls are verified.
# Whitelist your server IP in Pionex before enabling private account sync.
FMR_PIONEX_BASE_URL=https://api.pionex.com
FMR_BINANCE_BASE_URL=https://fapi.binance.com
FMR_DATABASE_URL=sqlite:///./market_radar.db
FMR_SCAN_INTERVAL_MINUTES=5
FMR_SCANNER_KLINE_LIMIT=120
FMR_SCANNER_MAX_SYMBOLS=120
FMR_SCANNER_MIN_QUOTE_VOLUME=50000
FMR_PIONEX_MAX_CONCURRENT_REQUESTS=16
FMR_SCANNER_QUOTE_ASSETS=USDT
FMR_REPORT_TIMEZONE=America/Toronto
FMR_ENABLE_MARKET_INTELLIGENCE=true
FMR_RUN_INITIAL_MARKET_INTELLIGENCE=false
FMR_MARKET_INTELLIGENCE_INTERVAL_MINUTES=180
FMR_MARKET_INTELLIGENCE_SOURCE_LIMIT=32
FMR_MARKET_INTELLIGENCE_ARTICLES_PER_SOURCE=8
FMR_MARKET_INTELLIGENCE_ARTICLE_TIMEOUT_SECONDS=8
FMR_MARKET_INTELLIGENCE_FETCH_ARTICLE_BODIES=true
FMR_ENABLE_AI_COMMENTARY=false
